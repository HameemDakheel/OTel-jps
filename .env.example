# obstack Simple profile environment
# Copy this file to .env and edit before running `make simple`.

# ─── Domain & TLS ──────────────────────────────────────────────────────────
# Public hostname for Caddy. Use "localhost" for local dev (self-signed cert).
# A real domain enables Caddy auto-TLS via Let's Encrypt.
DOMAIN=localhost

# Email used by Caddy when requesting Let's Encrypt certs.
# Required when DOMAIN is a real public domain.
ACME_EMAIL=admin@example.com

# ─── Authentication ────────────────────────────────────────────────────────
# Grafana admin login (used on first launch; change after login).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Basic auth for OTLP ingestion endpoints (protected by Caddy).
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
BASIC_AUTH_USER=ingest
BASIC_AUTH_HASH=$2a$14$Z9Lr.JI8h6yrkqu6E9c7Pez3K8iH6zS6h8Y5J6K9L1N4M2P3Q5R7S

# ─── Frontend RUM (Real User Monitoring) ───────────────────────────────────
# Your frontend's real origin, e.g. https://example.com — NOT a wildcard.
# The Grafana Faro Web SDK posts here cross-origin, so CORS on the faro
# receiver has to name your exact origin. localhost default works for local
# dev only; set this to your real domain before going live.
FRONTEND_ORIGIN=http://localhost:3000

# ─── Retention overrides (Simple profile defaults shown) ───────────────────
PROMETHEUS_RETENTION=7d
VICTORIALOGS_RETENTION=7d
TEMPO_RETENTION_HOURS=72
PYROSCOPE_RETENTION_HOURS=336

# ─── Resource hints (Simple profile) ───────────────────────────────────────
# These are advisory; compose/simple.yml applies the actual limits.
STACK_PROFILE=simple

# ─── Alerting: pick ONE delivery mechanism before going live ───────────────
# `make verify` checks whether EITHER of these two is genuinely configured
# (not just left at its placeholder) and fails until at least one is real —
# see scripts/verify_stack.sh's own comment on why it checks both rather than
# assuming every deployment wants the same one. Which one actually gets used
# is decided in configs/grafana/provisioning/alerting/notification-policies.yaml
# (`receiver: default-webhook` or `receiver: default-email`) — the shipped
# default there is `default-email`.

# Option A — webhook (Slack/Discord/PagerDuty/etc.). The value below is a
# placeholder that accepts every alert and delivers none of them — silently,
# with no error.
ALERT_WEBHOOK_URL=https://example.invalid/alert

# Option B — email via SMTP. Works with any SMTP provider (Microsoft 365,
# Gmail, SES, ...); these are Grafana's own SMTP client settings, passed
# through unchanged. SMTP_ENABLED must be explicitly "true" — left at "false"
# (or unset), Grafana never even tries to connect, which is the safe default
# for anyone not using email.
SMTP_ENABLED=false
# host:port — smtp.office365.com:587 for Microsoft 365 (STARTTLS on 587).
SMTP_HOST=smtp.office365.com:587
# The mailbox's own login — usually its full email address.
SMTP_USER=
# The mailbox's password, or an app password if the account has MFA enabled
# (Microsoft 365 and personal Outlook.com accounts both increasingly require
# one — check the account's security settings if plain auth is rejected).
SMTP_PASSWORD=
# What recipients see as the sender. Usually the same mailbox as SMTP_USER.
SMTP_FROM_ADDRESS=alerts@example.invalid
SMTP_FROM_NAME=obstack Alerts
# Where alerts actually go. Semicolon-separate multiple addresses.
ALERT_EMAIL_ADDRESSES=alerts@example.invalid

# ─── Standard profile defaults (uncomment when running `make standard`) ────
# Default Simple-profile retention is 7 days. Standard profile targets 30
# days by default — uncomment these to switch:
# PROMETHEUS_RETENTION=30d
# VICTORIALOGS_RETENTION=30d
# TEMPO_RETENTION_HOURS=168
# PYROSCOPE_RETENTION_HOURS=720
