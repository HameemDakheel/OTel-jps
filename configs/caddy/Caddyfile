# Global options
{
    email {$ACME_EMAIL:admin@example.com}
    # Auto HTTPS uses Let's Encrypt for any non-localhost DOMAIN.
    # For localhost, Caddy generates an internal self-signed cert automatically.
}

{$DOMAIN:localhost} {
    encode gzip zstd

    # Grafana UI on root
    handle / {
        reverse_proxy grafana:3000
    }

    handle_path /grafana/* {
        reverse_proxy grafana:3000
    }

    # OTLP HTTP ingestion (basic auth required).
    # Use `handle` (NOT `handle_path`) so the /v1 prefix is preserved when
    # forwarding to otel-collector — the OTLP receiver expects /v1/traces,
    # /v1/metrics, /v1/logs.
    handle /v1/* {
        basic_auth {
            {$BASIC_AUTH_USER:ingest} {$BASIC_AUTH_HASH:$2a$14$1234567890123456789012abcdefghijklmnopqrstuvwxyzABCDEFGHIJ}
        }
        reverse_proxy otel-collector:4318
    }

    # Default: proxy to Grafana
    reverse_proxy grafana:3000
}

# OTLP gRPC endpoint on port 4317 (HTTP/2)
:4317 {
    reverse_proxy otel-collector:4317 {
        transport http {
            versions h2c 2
        }
    }
}

# Pyroscope continuous-profiling ingest, dedicated port (basic auth required).
#
# Deliberately a separate port, not a /pyroscope/* path prefix under the main
# site block above — mirrors the :4317 block immediately above this one,
# which already proves the pattern in this file. A path-prefix route would
# need to choose between `handle` (preserve the prefix) and `handle_path`
# (strip it), and getting that choice wrong is exactly the class of bug that
# shipped in the /v1/* block once already (see its own comment). Pyroscope's
# own HTTP API has no concept of a mounted sub-path — it expects requests at
# its bare root paths — so a prefix route would need `handle_path` to strip
# it before forwarding, the OPPOSITE of what /v1/* needs. A dedicated port
# sidesteps that decision entirely: nothing to strip or preserve.
#
# pyroscope-go's client config natively supports this — set
# ServerAddress: "https://<DOMAIN>:4040" plus BasicAuthUser/BasicAuthPassword
# (confirmed against Grafana's own Go client docs, 2026-08-24). No OTel
# Collector involvement needed or expected: profiles push directly from the
# instrumented process to Pyroscope's own ingest API, same as this stack's
# upstream Pyroscope always intended. The OTel Collector's own profiles
# signal is a SEPARATE, still-experimental path (behind a
# --feature-gates=service.profilesSupport flag upstream, "active development
# with breaking changes" per Grafana's docs) — not what this route or the
# collector config's own comment should be describing. See
# configs/otel-collector/config.yaml's corrected comment.
:4040 {
    basic_auth {
        {$BASIC_AUTH_USER:ingest} {$BASIC_AUTH_HASH:$2a$14$1234567890123456789012abcdefghijklmnopqrstuvwxyzABCDEFGHIJ}
    }
    reverse_proxy pyroscope:4040
}

# Internal Docker hostname site (for in-network clients like examples/otel-demo).
# Forces internal self-signed cert (no ACME) and reuses the same auth + routing.
caddy, obstack-caddy {
    tls internal
    encode gzip zstd
    handle / {
        reverse_proxy grafana:3000
    }
    handle /v1/* {
        basic_auth {
            {$BASIC_AUTH_USER:ingest} {$BASIC_AUTH_HASH:$2a$14$1234567890123456789012abcdefghijklmnopqrstuvwxyzABCDEFGHIJ}
        }
        reverse_proxy otel-collector:4318
    }
    reverse_proxy grafana:3000
}
